# Copy to .env and fill in — mise loads it automatically (see mise.toml's
# `_.file` directive) into every `pnpm dev`/`pnpm test`/`pnpm --filter ...`
# invocation. Never committed (see .gitignore).

# One global choice for the whole dilna instance (ADR-0020) — valid
# DILNA_PROVIDER values: anthropic, deepseek, moonshotai, zai.
DILNA_PROVIDER=anthropic
DILNA_MODEL=

# Set only the one matching DILNA_PROVIDER (ADR-0005 host-passthrough).
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
ZAI_API_KEY=

# Optional: lets sessions open PRs / read-comment on issues via `gh`.
# Generate with `gh auth login` then `gh auth token` (ADR-0013).
GH_TOKEN=
